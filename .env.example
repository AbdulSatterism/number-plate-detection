# Copy to .env and adjust as needed. All are optional (sensible defaults shown).

# --- Detection ---
DETECTOR_WEIGHTS=models/plate.pt   # your trained YOLO weights (auto-used if present)
BASE_WEIGHTS=yolov8n.pt            # fallback base model (auto-downloads)
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
CROP_PADDING=0.02                  # pad plate crop before OCR (fraction of box size)

# --- OCR ---
OCR_LANGUAGES=bn,en               # EasyOCR language codes
OCR_MIN_CONFIDENCE=0.1

# --- Runtime ---
DEVICE=                           # "", "cpu", or GPU index like "0"
USE_GPU=                          # "true"/"false"; blank = auto-detect CUDA
FULL_FRAME_FALLBACK=true          # OCR whole image when detector is untrained
MAX_UPLOAD_MB=15
